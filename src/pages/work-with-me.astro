---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/lc/Nav.astro';
import Footer from '../components/lc/Footer.astro';
import Container from '../components/lc/Container.astro';
import PageHero from '../components/lc/PageHero.astro';
import SectionHeader from '../components/lc/SectionHeader.astro';
import Label from '../components/lc/Label.astro';
import DotList from '../components/lc/DotList.astro';
import Button from '../components/lc/Button.astro';
import BookingWidget from '../components/BookingWidget.astro';
import { facts } from '../data/facts';
import { config, hasFormspree } from '../data/config';

// Formspree and Cal.com IDs live in src/data/config.ts. Both features hide
// themselves until configured, so the page never ships a dead form.

// Every number, title, name and date on this page comes from src/data/facts.ts.
// Do not retype one here - npm run check:facts will fail the build.
import { approvedQuote } from '../data/testimonials';

// Quotes appear only once the person has approved them (src/data/testimonials.ts);
// the section disappears while none is approved.
const coachingTestimonials = [
  { id: 'merletti-coaching', role: `${facts.people.merletti.title}, ${facts.aisc.schoolShort}` },
  { id: 'brigham-coaching', role: `${facts.people.brigham.title}, ${facts.aisc.schoolShort}` },
  { id: 'gomez-escobar-coaching', role: `${facts.people.gomezEscobar.title}, ${facts.aisc.schoolShort}, endorsed the coaching twice, months apart` },
].flatMap((t) => {
  const q = approvedQuote(t.id);
  return q ? [{ ...t, quote: q.quote, name: q.name }] : [];
});
---

<Layout
  title="Work With Me"
  description="AI integration coaching for educators and professionals. School workshops, 1:1 coaching, HUMAN Framework implementation, and consulting services."
>
  <Nav />
  <main>

    <!-- HERO -->
    <PageHero label="Work With Me">
      <Fragment slot="title">
        Coaching, Training &amp; Consulting<br />
        <span class="text-barro">for Educators, Professionals &amp; Organizations</span>
      </Fragment>
      My approach is always the same: efficiency, efficacy, sustainability, and above all, partnership.
      Whether you're an individual educator, a leadership team, or a professional outside education,
      I'm here to walk alongside you.
      <Fragment slot="actions">
        <Button href="#contact">Start a Conversation</Button>
      </Fragment>
    </PageHero>

    <!-- FOR EDUCATORS -->
    <section class="py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="For Educators & Schools" title="Services That Meet You Where You Are">
          Every educator and every school has unique needs. I design services to be flexible,
          practical, and deeply responsive to your context.
        </SectionHeader>
        <div class="grid gap-lc-5 md:grid-cols-2">
          {[
            {
              title: 'AI Integration Coaching',
              sub: '1:1 or small groups',
              desc: 'Personalized coaching sessions helping educators build confidence with AI tools, develop their own informed philosophy, and integrate AI purposefully into their practice.',
              details: ['Tool selection and setup', 'Prompt engineering for teachers', 'HUMAN Framework introduction', 'Classroom application planning', 'Ethics and data privacy'],
            },
            {
              title: 'School-Wide Workshops & PD',
              sub: 'Half-day to multi-session programs',
              desc: 'Interactive professional development for faculty and staff, from foundational AI literacy to advanced implementation of the HUMAN Framework and LEA system.',
              details: ['AI foundations for educators', 'HUMAN Framework rollout', 'LEA implementation training', 'Digital citizenship curriculum', 'Leadership data strategy sessions'],
            },
            {
              title: 'HUMAN Framework Implementation',
              sub: 'Consulting engagement',
              desc: `Full implementation support for the HUMAN Framework, co-delivered with ${facts.people.perezTalavera.name}. Includes customization to your school context, teacher training, and dashboard setup.`,
              details: ['School-specific customization', 'Faculty training series', 'LEA tool configuration', 'Leadership reporting setup', 'Ongoing support'],
            },
            {
              title: 'Systems & Efficiency Consulting',
              sub: 'Custom engagements',
              desc: 'Custom solutions for schools navigating platform transitions, workflow inefficiencies, or digital system gaps, from Google Workspace rollouts to custom automation tools.',
              details: ['EdTech audit & roadmap', 'Platform transition support', 'Custom tool development', 'Data workflow design', 'Staff capacity building'],
            },
          ].map(({ title, sub, desc, details }) => (
            <div class="flex flex-col gap-lc-3 rounded-medium border border-tierra/15 bg-blanco p-lc-5 md:p-lc-6">
              <h3 class="font-display text-heading text-tierra">{title}</h3>
              <Label tone="suave">{sub}</Label>
              <p class="text-small text-tierra-suave">{desc}</p>
              <DotList items={details} tone="tierra" class="pt-lc-2" />
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- FOR PROFESSIONALS -->
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="For Professionals & Teams" title="Work Smarter with AI, Without Losing Control of Your Data">
          Not in education? No problem. Whether you're a lawyer, doctor, business owner, or executive,
          I help you harness AI tools that actually fit how you work, with a focus on data privacy and practical results.
        </SectionHeader>

        <div class="flex flex-col gap-lc-4 rounded-medium border border-tierra/15 bg-blanco p-lc-5 md:p-lc-6">
          <h3 class="font-display text-heading text-tierra">Who This Is For</h3>
          <DotList tone="tierra" class="grid gap-x-lc-6 sm:grid-cols-2 md:grid-cols-3">
            {[
              'Legal Professionals: contracts, research, correspondence',
              'Healthcare: documentation, patient comms, research',
              'Business Owners: operations, marketing, planning',
              'Finance & Insurance: reports, analysis, compliance',
              'Executive Teams: strategy, communication, decisions',
              'Anyone who writes, analyzes, or decides for a living',
            ].map(item => (
              <li>{item}</li>
            ))}
          </DotList>
        </div>

        <div class="grid gap-lc-5 md:grid-cols-3">
          {[
            {
              title: 'AI Readiness Call',
              sub: 'Free, 30 minutes',
              desc: "Let's talk about your work and identify where AI can have the biggest impact. No commitment, just clarity.",
              cta: 'Book a Call',
            },
            {
              title: '1:1 AI Coaching',
              sub: 'Personalized sessions',
              desc: 'Focused on your specific role and real workflows. Virtual, flexible scheduling, hands-on with your actual documents.',
              cta: 'Learn More',
            },
            {
              title: 'Team Workshops',
              sub: '3-8 participants',
              desc: 'Customized to your industry. Half-day intensives or multi-session programs. Virtual or on-site.',
              cta: 'Inquire',
            },
          ].map(({ title, sub, desc, cta }) => (
            <div class="flex flex-col gap-lc-3 rounded-medium border border-tierra/15 bg-blanco p-lc-5">
              <h3 class="font-display text-heading text-tierra">{title}</h3>
              <Label tone="suave">{sub}</Label>
              <p class="text-small text-tierra-suave">{desc}</p>
              <Button href="#contact" variant="secondary" size="sm" class="mt-auto w-full">{cta}</Button>
            </div>
          ))}
        </div>

        <div class="grid gap-lc-5 md:grid-cols-2">
          <div class="flex flex-col gap-lc-4 rounded-medium border border-tierra/15 bg-blanco p-lc-5 md:p-lc-6">
            <h3 class="font-display text-heading text-tierra">What You Get</h3>
            <DotList tone="tierra">
              {[
                'Live sessions (recorded for your reference)',
                'Custom prompt library tailored to your work',
                'Tool recommendations based on your privacy needs',
                'Quick reference guides and frameworks',
                '30 days follow-up support via email',
              ].map(item => (
                <li>{item}</li>
              ))}
            </DotList>
          </div>
          <div class="flex flex-col gap-lc-4 rounded-medium border border-tierra/15 bg-blanco p-lc-5 md:p-lc-6">
            <h3 class="font-display text-heading text-tierra">Tools We Cover</h3>
            <dl class="flex flex-col gap-lc-3">
              {[
                { tool: 'Claude', note: 'Best for confidential/legal work, complex analysis' },
                { tool: 'ChatGPT', note: 'General productivity, creative tasks' },
                { tool: 'Gemini', note: 'Google Workspace integration, research' },
                { tool: 'Industry-specific', note: 'Based on your particular needs' },
              ].map(({ tool, note }) => (
                <div class="flex gap-lc-3 text-small">
                  <dt class="w-28 shrink-0 font-semibold text-tierra">{tool}</dt>
                  <dd class="text-tierra-suave">{note}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </Container>
    </section>

    <!-- HOW I WORK -->
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="My Approach" title="How I Work" />
        <ol class="grid gap-lc-6 md:grid-cols-3">
          {[
            {
              step: '01',
              title: 'Discovery',
              desc: 'We start with a free 30-minute conversation. I learn about your context, challenges, and goals, and you get a clear sense of whether this is the right fit.',
            },
            {
              step: '02',
              title: 'Design',
              desc: 'I design an engagement specific to your needs. Not a packaged course: a tailored approach that works with your real workflows, documents, and constraints.',
            },
            {
              step: '03',
              title: 'Partnership',
              desc: 'We work together iteratively. You apply what we explore to your actual work. I provide feedback, adjustment, and ongoing support to make sure it sticks.',
            },
          ].map(({ step, title, desc }) => (
            <li class="flex flex-col gap-lc-3 border-t-2 border-tierra pt-lc-4">
              <span class="font-mono text-label uppercase text-barro">{step}</span>
              <h3 class="font-display text-heading text-tierra">{title}</h3>
              <p class="text-body text-tierra-suave">{desc}</p>
            </li>
          ))}
        </ol>
      </Container>
    </section>

    <!-- TESTIMONIALS: shown only when at least one quote is approved -->
    {coachingTestimonials.length > 0 && (
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="What People Say" title="From Educators I've Worked With" />
        <div class="grid gap-lc-5 md:grid-cols-3">
          {coachingTestimonials.map(({ quote, name, role }) => (
            <figure class="flex flex-col gap-lc-4 rounded-medium border border-tierra/15 bg-blanco p-lc-5">
              <span class="h-lc-3 w-lc-3 rounded-full bg-barro" aria-hidden="true"></span>
              <blockquote class="flex-1 text-small text-tierra">"{quote}"</blockquote>
              <figcaption class="flex flex-col gap-lc-1 border-t border-tierra/15 pt-lc-3">
                <span class="text-small font-semibold text-tierra">{name}</span>
                <span class="text-small text-tierra-suave">{role}</span>
              </figcaption>
            </figure>
          ))}
        </div>
        <Label as="p" tone="suave">{facts.survey.retentionPct} service retention · {facts.survey.outcomesPct} improved learning outcomes · {facts.survey.responses} educator survey responses</Label>
      </Container>
    </section>
    )}

    <!-- INVESTMENT -->
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="Investment" title="Flexible to Your Context">
          I believe in accessible, transparent pricing. Educators and professionals start with a free
          discovery call, no obligation, just a conversation. From there, we design an engagement that
          fits your budget and goals.
        </SectionHeader>
        <div class="grid max-w-4xl gap-lc-5 sm:grid-cols-3">
          {[
            { label: 'Discovery Call', price: 'Free', note: '30 min · No commitment' },
            { label: '1:1 Session', price: 'From $75', note: '90 min · Virtual' },
            { label: 'Team Program', price: 'From $600', note: '4 sessions · 3–8 people' },
          ].map(({ label, price, note }) => (
            <div class="flex flex-col gap-lc-1 rounded-medium border border-tierra/15 bg-blanco p-lc-5">
              <span class="font-display text-title text-tierra">{price}</span>
              <span class="pt-lc-2 text-small font-semibold text-tierra">{label}</span>
              <Label as="span" tone="suave">{note}</Label>
            </div>
          ))}
        </div>
        <p class="max-w-body text-small text-tierra-suave">
          Schools and organizations: custom pricing for multi-session programs and school-wide implementations.
          Contact me to discuss.
        </p>
      </Container>
    </section>

    <BookingWidget />

    <!-- CONTACT FORM -->
    <section id="contact" class="scroll-mt-lc-9 pt-lc-8">
      <Container>
        <div class="flex flex-col gap-lc-6 rounded-medium bg-selva px-lc-5 py-lc-7 text-arena md:px-lc-8 md:py-lc-8">
          <SectionHeader tone="dark" label="Get in Touch" title="Ready to Start?">
            Whether you have a specific challenge in mind or just want to explore possibilities,
            the first conversation is always free.
          </SectionHeader>

          {hasFormspree ? (
          <form
            action={`https://formspree.io/f/${config.formspreeId}`}
            method="POST"
            class="flex max-w-3xl flex-col gap-lc-5"
            id="contact-form"
          >
            <div class="grid gap-lc-5 sm:grid-cols-2">
              <div>
                <label for="name" class="mb-lc-2 block text-small font-semibold text-cielo">Full Name *</label>
                <input type="text" id="name" name="name" required
                  class="w-full rounded-small border border-arena/30 bg-arena px-lc-4 py-lc-3 text-body text-tierra placeholder:text-tierra-suave focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-arena"
                  placeholder="Your name"
                />
              </div>
              <div>
                <label for="email" class="mb-lc-2 block text-small font-semibold text-cielo">Email *</label>
                <input type="email" id="email" name="email" required
                  class="w-full rounded-small border border-arena/30 bg-arena px-lc-4 py-lc-3 text-body text-tierra placeholder:text-tierra-suave focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-arena"
                  placeholder="your@email.com"
                />
              </div>
            </div>

            <div>
              <label for="type" class="mb-lc-2 block text-small font-semibold text-cielo">I am a… *</label>
              <select id="type" name="type" required
                class="w-full rounded-small border border-arena/30 bg-arena px-lc-4 py-lc-3 text-body text-tierra placeholder:text-tierra-suave focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-arena"
              >
                <option value="">Select…</option>
                <option value="educator">Educator / Teacher</option>
                <option value="school-leader">School Leader / Administrator</option>
                <option value="professional">Professional (non-education)</option>
                <option value="conference">Conference / Event Organizer</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div>
              <label for="subject" class="mb-lc-2 block text-small font-semibold text-cielo">Subject *</label>
              <input type="text" id="subject" name="subject" required
                class="w-full rounded-small border border-arena/30 bg-arena px-lc-4 py-lc-3 text-body text-tierra placeholder:text-tierra-suave focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-arena"
                placeholder="What would you like to discuss?"
              />
            </div>

            <div>
              <label for="message" class="mb-lc-2 block text-small font-semibold text-cielo">Message *</label>
              <textarea id="message" name="message" required rows="5"
                class="w-full rounded-small border border-arena/30 bg-arena px-lc-4 py-lc-3 text-body text-tierra placeholder:text-tierra-suave focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-arena resize-none"
                placeholder="Tell me about your context, needs, or questions…"
              ></textarea>
            </div>

            <button type="submit" class="inline-flex w-full items-center justify-center rounded-small bg-barro px-lc-5 py-lc-3 text-body font-semibold text-arena transition-colors hover:bg-tierra focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-arena">
              Send Message
            </button>
            <p class="text-small text-cielo">
              Or email directly: <a href={`mailto:${facts.person.email}`} class="text-arena underline decoration-barro-claro underline-offset-4 hover:text-cielo">{facts.person.email}</a>
              · <a href={`https://www.${facts.person.linkedin}/`} target="_blank" rel="noopener" class="text-arena underline decoration-barro-claro underline-offset-4 hover:text-cielo">LinkedIn</a>
            </p>
          </form>
          ) : (
            <div class="flex flex-col items-start gap-lc-4">
              <Button href={`mailto:${facts.person.email}?subject=Let's work together`}>
                Email Me
              </Button>
              <p class="text-small text-cielo">
                <a href={`mailto:${facts.person.email}`} class="text-arena underline decoration-barro-claro underline-offset-4 hover:text-cielo">{facts.person.email}</a>
                · <a href={`https://www.${facts.person.linkedin}/`} target="_blank" rel="noopener" class="text-arena underline decoration-barro-claro underline-offset-4 hover:text-cielo">LinkedIn</a>
              </p>
            </div>
          )}
        </div>
      </Container>
    </section>

  </main>
  <Footer />
</Layout>
