---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { facts } from '../../data/facts';

// Every number, title, name and date on this page comes from src/data/facts.ts.
// Do not retype one here - npm run check:facts will fail the build.

const caseStudies = [
  {
    href: '/work/discover-india-trip-assignment',
    tag: 'Systems',
    chapter: 'Chapter 1 · Prove it on one hard problem',
    title: 'Discover India Trip Assignment',
    desc: `The assignment engine behind ${facts.aisc.schoolShort}'s "Week Without Walls", placing ${facts.discoverIndia.students} incoming Grade 9 students across ${facts.discoverIndia.trips} experiential trips by ranked preference, capacity, and gender balance, with a ${facts.discoverIndia.manualPages}-page operations manual so it never depends on me again.`,
    metrics: [`${facts.discoverIndia.students} students`, `${facts.discoverIndia.trips} trips`, `${facts.discoverIndia.manualPages}-page manual`],
    color: 'amber',
  },
  {
    href: '/work/sevai-assignment-system',
    tag: 'Automation',
    title: 'SEVAI Assignment System',
    desc: `A ${facts.sevai.scriptLines} line Apps Script automation that assigns ${facts.sevai.students} students to ${facts.sevai.activities} community-service activities by ranked preference, balanced across grades, replacing ${facts.sevai.hoursSaved} hours of manual work.`,
    metrics: [`${facts.sevai.students} students`, `${facts.sevai.activities} activities`, `${facts.sevai.hoursSaved} hrs saved`],
    color: 'teal',
  },
  {
    href: '/work/student-assignment-systems',
    tag: 'Systems',
    chapter: 'Chapter 2 · Turn the solution into infrastructure',
    title: 'Student Assignment Systems',
    desc: `The logistics infrastructure behind experiential learning, assignment engines for SEVAI, Discover India, Discovery Day, and STEAM Week that quietly placed ${facts.assignmentSystems.studentsPlaced} students and saved ${facts.assignmentSystems.hoursSavedPerYear} hours of manual work a year.`,
    metrics: [`${facts.assignmentSystems.studentsPlaced} students placed`, `${facts.assignmentSystems.programs} programs`, `${facts.assignmentSystems.hoursSavedPerYear} hours saved`],
    color: 'amber',
  },
  {
    href: '/work/health-office-app',
    tag: 'Full-stack',
    chapter: 'Chapter 3 · Go school-wide, and go fast',
    title: 'Health Office App',
    desc: `A Firebase + React student check-in system with automated, same-day notifications to teachers and secretaries, a duty-of-care gap closed for all ${facts.scale.students} students, from school-wide launch to live automated notifications in six days.`,
    metrics: [`${facts.scale.students} students`, 'Firebase + React', 'School-wide launch'],
    color: 'amber',
  },
  {
    href: '/work/curriculum-intelligence',
    tag: 'Flagship',
    chapter: "Chapter 4 · Become the institution's memory",
    title: 'Curriculum Intelligence Dashboard',
    desc: `A Google Apps Script web app that turned scattered curriculum documents into a live analytics system, tracking ${facts.curriculum.courses} courses and ${facts.curriculum.units} units across three divisions, put in front of ${facts.scale.leaders} leaders, and adopted by the director as the first onboarding resource ${facts.scale.incomingTeachers} new teachers received.`,
    metrics: [`${facts.curriculum.courses} courses`, `${facts.curriculum.units} units · ${facts.curriculum.completion} complete`, `${facts.scale.leaders} leaders`],
    color: 'teal',
  },
];
---

<Layout
  title="Selected Work"
  description={`Case studies from ${facts.person.shortName}'s work at the ${facts.aisc.school}, curriculum analytics, student assignment systems, and full-stack school tools.`}
>
  <Nav />
  <main>

    <!-- HERO -->
    <section class="bg-gradient-to-br from-navy to-teal-900 text-white py-20 md:py-28">
      <div class="max-w-6xl mx-auto px-4 md:px-8 text-center">
        <span class="tag bg-white/10 text-white border border-white/20 mb-6 inline-block">Selected Work</span>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">Systems That Make Institutional Knowledge Stick</h1>
        <p class="text-gray-300 text-lg max-w-2xl mx-auto">
          These projects are one story told at increasing scale. It starts with a single high-stakes
          logistics problem, placing one grade into its signature trips, and ends with the school's
          entire curriculum becoming searchable infrastructure that a director now hands to new teachers
          on day zero. At each step the question was the same: can this run without me? Every system
          below shipped with the documentation, training, and handover to answer yes.
        </p>
      </div>
    </section>

    <!-- CASE STUDIES -->
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-6xl mx-auto px-4 md:px-8">
        <div class="grid md:grid-cols-2 gap-8">
          {caseStudies.map(({ href, tag, chapter, title, desc, metrics, color }) => (
            <a href={href} class={`card group block border-t-4 ${color === 'teal' ? 'border-teal' : 'border-amber'}`}>
              <span class="tag text-xs mb-3">{tag}</span>
              {chapter && <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-1">{chapter}</p>}
              <h2 class="text-xl font-bold text-navy mb-3 group-hover:text-teal transition-colors">{title}</h2>
              <p class="text-gray-600 text-sm leading-relaxed mb-5">{desc}</p>
              <div class="flex flex-wrap gap-2 mb-5">
                {metrics.map(m => (
                  <span class="bg-gray-50 text-gray-600 text-xs rounded-full px-3 py-1 font-medium">{m}</span>
                ))}
              </div>
              <span class={`text-sm font-medium ${color === 'teal' ? 'text-teal' : 'text-amber-dark'}`}>Read the case study →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-navy text-white">
      <div class="max-w-3xl mx-auto px-4 md:px-8 text-center">
        <h2 class="text-3xl font-bold mb-6">Want something like this built for your school?</h2>
        <p class="text-gray-300 mb-8">
          These systems started as someone's spreadsheet headache. If you have a workflow that should
          be automated, a data problem that should be a dashboard, or a tool that doesn't exist yet, let's talk.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/work-with-me" class="btn-amber">Work With Me</a>
          <a href={`mailto:${facts.person.email}`} class="btn-secondary border-white/40 text-white hover:bg-white hover:text-teal">Send an Email</a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
