---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/lc/Nav.astro';
import Footer from '../components/lc/Footer.astro';
import Container from '../components/lc/Container.astro';
import PageHero from '../components/lc/PageHero.astro';
import SectionHeader from '../components/lc/SectionHeader.astro';
import Prose from '../components/lc/Prose.astro';
import Label from '../components/lc/Label.astro';
import Tag from '../components/lc/Tag.astro';
import DotList from '../components/lc/DotList.astro';
import Timeline from '../components/lc/Timeline.astro';
import TimelineItem from '../components/lc/TimelineItem.astro';
import Button from '../components/lc/Button.astro';
import CtaPanel from '../components/lc/CtaPanel.astro';
import CalendarHeatmap from '../components/CalendarHeatmap.astro';
import { facts, range } from '../data/facts';

// Every number, title, name and date on this page comes from src/data/facts.ts.
// Do not retype one here - npm run check:facts will fail the build.
---

<Layout
  title="My Journey"
  description={`From systems engineering in Venezuela to learning innovation coaching across ${facts.scale.countriesLived} countries, the full career journey of ${facts.person.shortName}.`}
>
  <Nav />
  <main>

    <!-- HERO -->
    <PageHero label="My Journey" title="From Systems Engineering to Human-Centered Education">
      A decade of building, teaching, coaching, and innovating across {facts.scale.countriesLived} countries and every
      role a school has to offer, with Venezuela always at the beginning of the story.
      <img
        slot="aside"
        src="/images/headshot-5.jpeg"
        alt="Luis Carlos Moreno"
        class="aspect-square w-64 rounded-medium object-cover object-top md:w-72"
      />
    </PageHero>

    <!-- IDENTITY & REPRESENTATION -->
    <section class="py-lc-9">
      <Container class="grid items-start gap-lc-8 md:grid-cols-2">
        <div class="flex flex-col gap-lc-5">
          <SectionHeader label="Identity & Practice" title="The Representation I Wished I'd Had" />
          <Prose>
            <p>
              I grew up in Valle de la Pascua, a small town in the Venezuelan plains, in a family of
              entrepreneurs and educators. My grandmother founded two schools there and ran her classroom
              as a small living democracy she called the <span lang="es">República Escolar</span>. I was working by age 7,
              managing my family's restaurant by 11. At 15, I moved to Texas to learn English, with
              nothing but drive and the certainty that education could open any door.
            </p>
            <p>
              As a queer, Latino, multilingual educator, I strive to be the representation I wished I'd had.
              My students shouldn't have to search for someone who looks like them, thinks like them,
              or navigated what they're navigating. I show up with that purpose every day.
            </p>
            <p>
              My DEIJ work isn't separate from my technology work. It is foundational to it. Every
              tool I build, every framework I design, begins with the question: <strong>who does this serve,
              and who might it leave out?</strong>
            </p>
            <blockquote>
              <p>"You will not tell me that you accept me. You will not tell me that you tolerate me.
              That is not your power. I take that from you. You will respect me for who I am."</p>
              <footer>Luis Carlos Moreno, AIELOC Conference Hanoi 2024</footer>
            </blockquote>
          </Prose>
        </div>
        <ul class="grid grid-cols-2 gap-lc-3">
          {[
              { emoji: '🇻🇪', label: 'Venezuelan', sub: 'Valle de la Pascua native' },
              { emoji: '🏳️‍🌈', label: 'Queer Educator', sub: 'DEIJ advocate' },
              { emoji: '🌍', label: `${facts.scale.countriesLived} Countries`, sub: `${facts.scale.countriesVisited} countries visited` },
              { emoji: '🎭', label: 'Hospital Clowns', sub: '9 years founding "Payasitos de Hospital"' },
              { emoji: '✍️', label: 'Published Writer', sub: 'Author, songwriter' },
              { emoji: '🗣️', label: 'Multilingual', sub: 'English · Spanish · Portuguese' },
            ].map(({ emoji, label, sub }) => (
            <li class="flex flex-col gap-lc-1 rounded-medium border border-tierra/15 bg-blanco p-lc-4">
              <span class="text-title leading-none" aria-hidden="true">{emoji}</span>
              <span class="pt-lc-2 text-small font-semibold text-tierra">{label}</span>
              <span class="text-small text-tierra-suave">{sub}</span>
            </li>
          ))}
        </ul>
      </Container>
    </section>

    <!-- CURRENT ROLES -->
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="Current Roles" title="Where I Am Now" />
        <div class="grid gap-lc-5 md:grid-cols-2">
          <div class="flex flex-col gap-lc-4 rounded-medium border border-tierra/15 bg-blanco p-lc-5 md:p-lc-6">
            <div class="flex flex-col gap-lc-2">
              <Label tone="suave">{range(facts.aisc)}</Label>
              <h3 class="font-display text-heading text-tierra">{facts.aisc.title}</h3>
              <p class="text-small font-semibold text-selva">{facts.aisc.school} ({facts.aisc.schoolShort}), India</p>
            </div>
            <DotList>
              <li>Co-led Apple Distinguished School certification ({facts.misc.appleYears} designation)</li>
              <li>Co-created HUMAN Framework with {facts.people.perezTalavera.name}</li>
              <li>Engineered LEA, analyzed {facts.scale.leaMonths} months of school-wide data</li>
              <li>Coached {facts.scale.facultyCoached} faculty using student-centered model (plan, observe, model, co-teach)</li>
              <li>Built {facts.scale.tools} automation tools, each adopted by name by the colleague who requested it</li>
              <li>Designed digital citizenship curriculum for {facts.scale.digitalCitizenshipStudents} students annually</li>
              <li>Managed Integration Studio: VR, podcasting, multimedia</li>
              <li>Facilitated parent &amp; community sessions on AI literacy and digital wellbeing</li>
            </DotList>
          </div>
          <div class="flex flex-col gap-lc-4 rounded-medium border border-tierra/15 bg-blanco p-lc-5 md:p-lc-6">
            <div class="flex flex-col gap-lc-2">
              <Label tone="suave">{range(facts.goa)}</Label>
              <h3 class="font-display text-heading text-tierra">{facts.goa.title}</h3>
              <p class="text-small font-semibold text-selva">{facts.goa.org} ({facts.goa.orgShort}), Worldwide</p>
            </div>
            <DotList>
              <li>Teaches Game Theory to students from member schools worldwide</li>
              <li>Teaches Introduction to Artificial Intelligence</li>
              <li>Creates custom instructional videos and competency-based assessments</li>
              <li>95%+ course completion rate</li>
              <li>Global, asynchronous, project-based learning model</li>
            </DotList>
          </div>
        </div>
      </Container>
    </section>

    <!-- AISC CALENDAR DENSITY -->
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="Two Years, One Calendar" title={`2,514 Calendar Events in Two Years at ${facts.aisc.schoolShort}`}>
          The dark squares are the job. Every cell is a day, July 2024 through June 2026.
        </SectionHeader>
        <CalendarHeatmap />
      </Container>
    </section>

    <!-- SPEAKING -->
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="Speaking" title="Conference Presentations" />
        <div class="grid gap-lc-5 sm:grid-cols-2">
          {[
            {
              year: '2025',
              conf: 'AIFE Conference',
              location: 'Jakarta, Indonesia',
              title: 'Human-Like System: AI for Human-Like Decisions',
              desc: 'Presented the HUMAN Framework and LEA as a complete system for ethical AI integration and school-wide strategic intelligence.',
            },
            {
              year: '2025',
              conf: 'Data in Schools Conference',
              location: 'Kuala Lumpur, Malaysia',
              title: 'Building Ethical AI Data Systems: From Classroom Guidance to Strategic Intelligence',
              desc: 'Live demonstration of LEA analyzing real learning activities, with full data pipeline from classroom to leadership dashboards.',
            },
            {
              year: '2024',
              conf: 'AIELOC Conference',
              location: 'Hanoi, Vietnam',
              title: 'Identity, Immigration, and Belonging in International Education',
              desc: 'Personal narrative presentation on navigating identity as a Venezuelan immigrant, queer Latino educator, and global citizen in international schools.',
            },
            {
              year: '2019',
              conf: 'PAIS Conference',
              location: 'Panama City, Panama',
              title: 'Escape Rooms & Breakout Boxes: Outside-the-Box Teaching',
              desc: 'Practical workshop on gamifying learning experiences through digital and physical escape rooms to drive student engagement.',
            },
          ].map(({ year, conf, location, title, desc }) => (
            <div class="flex flex-col gap-lc-3 rounded-medium border border-tierra/15 bg-blanco p-lc-5 md:p-lc-6">
              <div class="flex flex-wrap items-center justify-between gap-lc-2">
                <Tag>{year}</Tag>
                <Label as="span" tone="suave">{location}</Label>
              </div>
              <Label>{conf}</Label>
              <h3 class="font-display text-body font-bold text-tierra">"{title}"</h3>
              <p class="text-small text-tierra-suave">{desc}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    <!-- FULL CAREER TIMELINE -->
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="Career Timeline" title="Every Role, Every School" />
        <Timeline class="max-w-3xl">
          {[
            {
              period: '2021 – 2023',
              role: `${facts.vis.title} · DEIJ Taskforce Member`,
              org: `${facts.vis.org} (${facts.vis.orgShort})`,
              location: 'Vientiane, Laos',
              points: [
                `${facts.vis.title} across multiple grade levels`,
                'Designed and taught a grades 6-12 financial literacy curriculum',
                'DEIJ Taskforce member, contributed to inclusion and equity culture initiatives',
                'Continued coaching educators in technology integration',
                'ISS DEIJ Learning to Action Institute (2021–2022)',
              ],
            },
            {
              period: range(facts.isp),
              role: facts.isp.roleChain,
              org: `${facts.isp.org} (${facts.isp.orgShort})`,
              location: 'Panama City, Panama',
              points: [
                `${facts.isp.roleCount} distinct roles across five years, built comprehensive understanding of the full school ecosystem`,
                'Led school-wide technology vision; primary administrator for Canvas LMS, FACTS SIS, Google Workspace',
                'Coached teachers in technology integration with tailored, data-driven support',
                'Taught middle school mathematics and served as Mathematics Department Head',
                'Provided learning support for grades 6–8 with individualized instruction and ILP development',
                'Consulted for Academia Hebrea de Panamá (2020), delivered strategic technology audit',
              ],
            },
            {
              period: range(facts.rabin),
              role: 'STEM & Robotics Teacher · Head of IT Department',
              org: facts.rabin.org,
              location: 'Panama City, Panama',
              points: [
                'Founded the school\'s STEM and Robotics program from the ground up',
                'Led IT Department, managed infrastructure, device deployment, and tech support',
                'Developed K-12 technology curriculum',
              ],
            },
            {
              period: '2011 – 2015',
              role: 'Private Tutor & Homeschool Educator',
              org: 'Independent',
              location: 'Panama',
              points: [
                'Tutored two brothers for 4 years, full homeschool model',
                'Subjects: STEM, Robotics, Mathematics, Information Technology',
                'Students achieved A and B grades on GCSE assessments',
                'Also supported AS & A Level students in mathematics',
              ],
            },
          ].map(({ period, role, org, location, points }) => (
            <TimelineItem>
              <div class="flex flex-wrap items-center gap-x-lc-4 gap-y-lc-1">
                <Label as="span" tone="suave">{period}</Label>
                <Label as="span" tone="suave">{location}</Label>
              </div>
              <h3 class="font-display text-body font-bold text-tierra">{role}</h3>
              <p class="text-small font-semibold text-selva">{org}</p>
              <DotList items={points} class="pt-lc-2" />
            </TimelineItem>
          ))}
        </Timeline>
      </Container>
    </section>

    <!-- CERTIFICATIONS & EDUCATION -->
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="grid gap-lc-8 md:grid-cols-2">
        <!-- Certifications -->
        <div class="flex flex-col gap-lc-6">
          <SectionHeader label="Certifications" title="Professional Credentials" />
          <ul class="flex flex-col">
            {[
                { name: 'COETAIL, Certificate of Educational Technology & Information Literacy', year: '' },
                { name: 'Google Certified Educator Level 1 & Level 2', year: '' },
                { name: 'UDL Associate Level 1 Credential', year: '' },
                { name: 'Apple Distinguished School, Certification Leader', year: '2024' },
                { name: 'International Teaching Certificate (TTC, Rome)', year: '2018' },
                { name: 'Coaching Skills for International Teacher Leaders (TTC, Rome)', year: '2018' },
                { name: 'Social & Emotional Teaching and Learning (TTC, Rome)', year: '2018' },
                { name: 'Special Needs Learning in International Schools (TTC, London)', year: '2017' },
                { name: 'Problem, Project & Design-Based Teaching (TTC, London)', year: '2017' },
                { name: 'Adaptive Schools Training', year: '' },
                { name: 'ISS DEIJ Learning to Action Institute', year: '2021–2022' },
                { name: 'Responsive Classroom for Elementary Educators', year: '2018' },
              ].map(({ name, year }) => (
              <li class="flex flex-wrap items-baseline gap-x-lc-3 gap-y-lc-1 border-b border-tierra/10 py-lc-3 last:border-0">
                <span class="text-small text-tierra">{name}</span>
                {year && <Label as="span" tone="suave">({year})</Label>}
              </li>
            ))}
          </ul>
        </div>

        <!-- Education -->
        <div class="flex flex-col gap-lc-6">
          <SectionHeader label="Education" title="Academic Background" />
          <div class="flex flex-col gap-lc-5">
            <div class="flex flex-col gap-lc-1 border-t border-tierra/15 pt-lc-4">
              <Label tone="suave">2013 – 2015</Label>
              <h3 class="font-display text-body font-bold text-tierra">Master's in Education</h3>
              <p class="text-small text-tierra-suave">Higher Education, Teaching Emphasis</p>
              <p class="text-small font-semibold text-selva">Universidad Tecnológica de Panamá</p>
            </div>
            <div class="flex flex-col gap-lc-1 border-t border-tierra/15 pt-lc-4">
              <Label tone="suave">2008 – 2012</Label>
              <h3 class="font-display text-body font-bold text-tierra">Bachelor's in Computer Science &amp; Systems Engineering</h3>
              <p class="text-small font-semibold text-selva">Universidad Tecnológica de Panamá</p>
            </div>
            <div class="flex flex-col gap-lc-1 border-t border-tierra/15 pt-lc-4">
              <Label tone="suave">2014 – 2015</Label>
              <h3 class="font-display text-body font-bold text-tierra">Postgraduate Specialization in Higher Education</h3>
              <p class="text-small font-semibold text-selva">Universidad Tecnológica de Panamá</p>
            </div>
            <div class="flex flex-col gap-lc-1 border-t border-tierra/15 pt-lc-4">
              <Label tone="suave">2015</Label>
              <h3 class="font-display text-body font-bold text-tierra">Creative Writing Diploma</h3>
              <p class="text-small font-semibold text-selva">Universidad Tecnológica de Panamá</p>
            </div>
          </div>

          <div class="flex flex-col gap-lc-4 pt-lc-4">
            <Label>Languages</Label>
            {[
                  { lang: 'Spanish', level: 'Native', pct: 100 },
                  { lang: 'English', level: 'Professional fluency', pct: 98 },
                  { lang: 'Portuguese', level: 'Conversational', pct: 55 },
                ].map(({ lang, level, pct }) => (
              <div class="flex flex-col gap-lc-2">
                <div class="flex justify-between text-small">
                  <span class="font-semibold text-tierra">{lang}</span>
                  <span class="text-tierra-suave">{level}</span>
                </div>
                <div class="h-lc-2 overflow-hidden rounded-full bg-tierra/10">
                  <div class="h-full rounded-full bg-selva" style={`width: ${pct}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <CtaPanel title="Want to know more or explore working together?">
      <Fragment slot="actions">
        <Button href="/work-with-me">Work With Me</Button>
        <Button href={`mailto:${facts.person.email}`} variant="secondary" tone="dark">Send an Email</Button>
      </Fragment>
    </CtaPanel>

  </main>
  <Footer />
</Layout>
