---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/lc/Nav.astro';
import Footer from '../components/lc/Footer.astro';
import Container from '../components/lc/Container.astro';
import Motif from '../components/lc/Motif.astro';
import SectionHeader from '../components/lc/SectionHeader.astro';
import Stats from '../components/lc/Stats.astro';
import Prose from '../components/lc/Prose.astro';
import Label from '../components/lc/Label.astro';
import Tag from '../components/lc/Tag.astro';
import Button from '../components/lc/Button.astro';
import CtaPanel from '../components/lc/CtaPanel.astro';
import Timeline from '../components/lc/Timeline.astro';
import TimelineItem from '../components/lc/TimelineItem.astro';
import { motifGeometry } from '../components/lc/motif';
import { facts, range, credit } from '../data/facts';

// Every number, title, name and date on this page comes from src/data/facts.ts.
// Do not retype one here - npm run check:facts will fail the build.

const { clear } = motifGeometry('content-slide', 'light');
---

<Layout title="Home" description={`${facts.aisc.title}, AI Integration Specialist, and Co-creator of the HUMAN Framework. Engineering solutions, empowering educators.`} brand>
  <Nav />
  <main>

    <!-- HERO -->
    <section class="relative border-b border-tierra/10" style="container-type:inline-size">
      <Motif placement="content-slide" scheme="light" />
      <Container class="relative py-lc-8 md:py-lc-9">
        <div class="grid items-center gap-lc-7 md:grid-cols-[minmax(0,1fr)_auto]" style={`padding-right:calc(${clear}cqw + 16px)`}>
          <div class="flex flex-col gap-lc-5">
            <Label>{`${facts.current.school} · ${facts.current.campus} ${facts.current.division} · Available for consulting`}</Label>
            <h1 class="font-display text-display text-tierra">
              Luis Carlos <span class="text-barro">Moreno</span>
            </h1>
            <div class="flex flex-col gap-lc-1 text-small font-semibold text-tierra-suave">
              <p>{facts.current.title} &nbsp;·&nbsp; {facts.aisc.title}</p>
              <p>Co-creator of the HUMAN Framework &nbsp;·&nbsp; {facts.goa.orgShort} Instructor &nbsp;·&nbsp; Apple Distinguished School co-lead</p>
            </div>
            <p class="font-display text-title text-tierra [text-wrap:balance]">
              I build school systems<br />that outlive their builder.
            </p>
            <p class="max-w-body text-body text-tierra-suave">
              A Venezuelan-born systems engineer turned international educator, I work at the
              intersection of coaching and code: close enough to pedagogy to know what teachers
              actually need, technical enough to build it myself. At my last school, the systems I
              built became the infrastructure: the dashboard {facts.scale.leaders} leaders run curriculum from, the
              app that tracks {facts.scale.students} students' health check-ins, the engine that places an entire grade
              into its signature trips. All of it still running after I left. That was the point.
            </p>
            <div class="flex flex-wrap gap-lc-3 pt-lc-2">
              <Button href="/experience">Explore My Journey</Button>
              <Button href="/work-with-me" variant="secondary">Work With Me</Button>
            </div>
          </div>
          <img
            src="/images/headshot-main.jpeg"
            alt="Luis Carlos Moreno"
            class="aspect-square w-64 rounded-medium object-cover object-top md:w-72 lg:w-96"
          />
        </div>
      </Container>
    </section>

    <!-- KEY NUMBERS -->
    <Container class="pt-lc-8">
      <Stats
        labels="text"
        items={[
          { value: facts.scale.incomingTeachers, label: 'New teachers onboarded through my system, before day one' },
          { value: facts.scale.leaders, label: 'School leaders running curriculum from my dashboard' },
          { value: facts.scale.students, label: 'Students covered by school-wide systems' },
          { value: facts.scale.tools, label: 'Tools shipped by request, adopted by name' },
        ]}
      />
    </Container>

    <!-- ABOUT -->
    <section class="py-lc-9">
      <Container class="grid items-start gap-lc-8 md:grid-cols-2">
        <div class="flex flex-col gap-lc-5">
          <SectionHeader label="About Me" title="I Build Systems That Make Institutional Knowledge Stick" />
          <Prose>
            <p>
              <span lang="es" class="text-barro">¡Hola, hola!</span> I'm Luis Carlos, a Venezuelan-born systems engineer who became an educator.
              It runs in the family: my grandmother founded two schools in Valle de la Pascua, the small
              town where I grew up, and I am the third generation to make teaching my work. I left for
              Texas at 15 to learn English, and have since lived and worked across {facts.scale.countriesLived} countries on
              three continents.
            </p>
            <p>
              At the {facts.aisc.school}, an IB World School of {facts.scale.students} students, I was
              the <strong>{facts.aisc.title} and {facts.aisc.secondTitle}</strong>.
              I co-led the school's Apple Distinguished School certification, co-created its framework for
              ethical AI use, and coached {facts.scale.facultyCoached} faculty. I started my career in the classroom teaching MYP
              Mathematics, and that path is exactly the point: I work at the intersection of coaching and
              engineering, translating what teachers actually need into tools they actually adopt.
            </p>
            <p>
              Here's the test I hold my own work to: <strong>does it keep running after I leave the
              room?</strong> The curriculum dashboard I built is how {facts.scale.leaders} {facts.aisc.schoolShort} leaders see their program,
              and in May 2026, the school's director sent the curriculum infrastructure behind it to {facts.scale.incomingTeachers}
              incoming teachers as the very first onboarding resource they received, before they'd even
              arrived in Chennai. The
              trip-assignment engine shipped with a {facts.discoverIndia.manualPages}-page operations manual so the program runs
              identically without me. That's what I mean by making institutional knowledge stick: not
              tools, infrastructure.
            </p>
            <p>
              As of <strong>{facts.current.startMonth} {facts.current.startYear} I'm bringing that playbook to {facts.current.school} ({facts.current.schoolShort} {facts.current.campus},
              {facts.current.division})</strong> as {facts.current.title}. Same belief, new campus: technology serves
              people, not the other way around. And one more thing every move has taught me: leaving
              your comfort zone gets easier the more you do it.
            </p>
            <blockquote>
              <p>"His support has significantly reduced stress for many of us and has made a complicated
              process much smoother."</p>
              <footer>{facts.people.keogh.name}, in a commendation to the Head of School</footer>
            </blockquote>
          </Prose>
          <div class="flex flex-wrap gap-lc-2">
            <Tag>Venezuelan</Tag>
            <Tag>Queer Educator</Tag>
            <Tag>{facts.scale.countriesLived} Countries</Tag>
            <Tag>EN · ES · PT</Tag>
          </div>
        </div>
        <div class="relative md:sticky md:top-lc-9">
          <img
            src="/images/headshot-2.jpeg"
            alt="Luis Carlos Moreno presenting"
            class="max-h-[480px] w-full rounded-medium object-cover"
          />
          <span class="absolute bottom-lc-4 right-lc-4 rounded-small bg-barro px-lc-3 py-lc-2 font-mono text-label uppercase text-arena">
            {facts.scale.countriesVisited} countries visited
          </span>
        </div>
      </Container>
    </section>

    <!-- SIGNATURE INNOVATIONS -->
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="Signature Innovations" title="Tools & Frameworks That Transform Education">
          From ethical AI integration guidelines to data-driven lesson analysis: built for real classrooms, real teachers, real impact.
        </SectionHeader>
        <div class="grid gap-lc-5 md:grid-cols-2">

          <!-- HUMAN Framework -->
          <div class="flex flex-col gap-lc-4 rounded-medium border border-tierra/15 bg-blanco p-lc-5 md:p-lc-6">
            <div class="flex flex-wrap items-start justify-between gap-lc-3">
              <div class="flex flex-col gap-lc-2">
                <Label tone="suave">Co-created with {facts.people.perezTalavera.name}</Label>
                <h3 class="font-display text-heading text-tierra">The HUMAN Framework</h3>
              </div>
              <Tag variant="status">Operational</Tag>
            </div>
            <p class="text-body text-tierra-suave">
              School-wide guidelines for ethical, human-centered AI integration in education. Five levels
              from pure human thinking to AI-created elements, give teachers a clear, flexible map
              for responsible AI use that preserves learning and maintains integrity.
            </p>
            <img src="/images/human-framework.png" alt="HUMAN Framework diagram" class="w-full rounded-small border border-tierra/15" />
            <div class="flex flex-wrap gap-lc-2">
              {['Preserving Learning', 'Maintaining Integrity', 'AIFE Jakarta', 'Data in Schools KL'].map(t => (
                <Tag>{t}</Tag>
              ))}
            </div>
            <Button href="/innovations#human-framework" variant="secondary" size="sm" class="mt-auto w-fit">
              Learn More →
            </Button>
          </div>

          <!-- LEA -->
          <div class="flex flex-col gap-lc-4 rounded-medium border border-tierra/15 bg-blanco p-lc-5 md:p-lc-6">
            <div class="flex flex-wrap items-start justify-between gap-lc-3">
              <div class="flex flex-col gap-lc-2">
                <Label tone="suave">AI-Powered Tool</Label>
                <h3 class="font-display text-heading text-tierra">Learning Experience Analyzer (LEA)</h3>
              </div>
              <Tag variant="status">Operational</Tag>
            </div>
            <p class="text-body text-tierra-suave">
              Teachers paste a learning activity and LEA instantly analyzes it against UbD, UDL, Bloom's
              Taxonomy, the HUMAN Framework, and school-specific mission &amp; values, generating
              actionable improvement recommendations in seconds.
            </p>
            <img src="/images/lea-web.jpeg" alt="LEA tool interface" class="w-full rounded-small border border-tierra/15" />
            <dl class="grid grid-cols-3 gap-lc-3">
              {[
                { who: 'Students', what: 'Better-designed learning experiences' },
                { who: 'Teachers', what: 'Streamlined planning, less cognitive load' },
                { who: 'Leadership', what: 'Data for strategic decisions' },
              ].map(({ who, what }) => (
                <div class="flex flex-col gap-lc-1 border-t border-tierra/15 pt-lc-2">
                  <dt class="text-small font-semibold text-tierra">{who}</dt>
                  <dd class="text-small text-tierra-suave">{what}</dd>
                </div>
              ))}
            </dl>
            <Button href="/innovations#lea" variant="secondary" size="sm" class="mt-auto w-fit">
              Learn More →
            </Button>
          </div>

        </div>
        <div>
          <Button href="/innovations">See All Innovations</Button>
        </div>
      </Container>
    </section>

    <!-- BUILT ON REQUEST -->
    <section class="bg-selva py-lc-9 text-arena">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader tone="dark" label="Built on Request" title="The Case Studies Are Five. The Requests Never Stopped.">
          Case studies get the spotlight. Most of what I built at {facts.aisc.schoolShort} started smaller: a colleague
          mentioned a headache, and a few days later there was a tool. More than twenty of these are in
          the record by name, each one adopted by the person who asked for it. This is the part of the
          job I care about most. Not the flagship launch. The Tuesday request.
        </SectionHeader>

        <blockquote class="flex max-w-3xl flex-col gap-lc-3 border-l-2 border-barro-claro pl-lc-5">
          <p class="text-lead text-arena">
            "Luis Carlos Moreno is our Technology and Innovation Coach, making amazing tools to improve
            teachers' lives, among his many other activities."
          </p>
          <p class="text-small text-cielo">
            {credit(facts.people.clinton)}, introducing me to an outside AI consultant
          </p>
        </blockquote>

        <div class="max-w-4xl border-t border-arena/20">
          {[
            { date: '2025-09', name: 'DT & Trip Safety Consent System', dept: 'MS Design Technology', desc: 'Digital consent forms with a signature-tracking dashboard, used daily by the department.', receipt: '"It has made a massive difference in our department."', who: credit(facts.people.hart) },
            { date: '2025-09', name: 'Science Report Comment Generator', dept: 'MS Science', desc: 'AI-assisted comment drafting with a walkthrough video, built for the whole team.', receipt: '"This spreadsheet is incredible, and the video is so concise and clear."', who: credit(facts.people.bull) },
            { date: '2025', name: 'French Report Comment Generator', dept: 'World Language', desc: 'Same pattern, second subject, adapted to the department\'s rubrics.', receipt: null, who: null },
            { date: '2025-12', name: 'EAL Progress Tracker', dept: 'EAL Department', desc: 'Gamified student-progress tool with linked reflection forms.', receipt: '"\'Game-like\' features... Impressive!"', who: credit(facts.people.brigham) },
            { date: '2025', name: 'MS Report Card Comment System v4.0', dept: 'All MS Teachers', desc: '1,914 comments managed per cycle, AI comment banks, one-click export to PowerTeacher Pro.', receipt: null, who: null },
            { date: '2025-10', name: 'Math Shark Tank Analysis Report', dept: 'Curriculum Leadership', desc: 'A data tool for curriculum-goal alignment, shared with schools abroad.', receipt: '"LC, this is SO cool... Amazing work!"', who: credit(facts.people.martin) },
            { date: '2024-09', name: 'Meeting Notes Auto-Transcriber', dept: 'ES Leadership', desc: 'Automated transcription and notes for leadership meetings.', receipt: '"This is amazing. I want to learn how to do this."', who: credit(facts.people.schneider) },
            { date: '2025', name: 'Innovation Bot', dept: 'Innovation in T&L Council', desc: 'A scoped AI assistant that helped faculty refine their innovation pitches.', receipt: null, who: null },
            { date: '2025-02', name: 'AI Book Club Companion Site', dept: `${facts.scale.bookClubEducators} Educators`, desc: 'Session resources and discussion hub for "Exploring Tomorrow."', receipt: null, who: null },
            { date: '2024', name: 'Learning Experience Analyzer (LEA)', dept: 'School-wide', desc: 'Multi-framework lesson analysis; the tool that grew into a data system.', receipt: null, who: null },
          ].map(({ date, name, dept, desc, receipt, who }) => (
            <details class="group border-b border-arena/20">
              <summary class="flex cursor-pointer list-none items-center gap-lc-4 py-lc-3 hover:text-cielo focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-arena [&::-webkit-details-marker]:hidden">
                <span class="h-lc-2 w-lc-2 shrink-0 rounded-full bg-barro" aria-hidden="true"></span>
                <span class="w-20 shrink-0 font-mono text-label uppercase text-cielo">{date}</span>
                <span class="flex-1 text-body font-semibold">{name}</span>
                <span class="hidden font-mono text-label uppercase text-cielo md:inline">{dept}</span>
                <span class="shrink-0 text-cielo transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
              </summary>
              <div class="flex flex-col gap-lc-3 pb-lc-4 pl-lc-8 pr-lc-4">
                <p class="max-w-body text-body">{desc}</p>
                {receipt && (
                  <p class="flex max-w-body flex-col gap-lc-1 border-l-2 border-barro-claro pl-lc-3 text-body">
                    {receipt}<span class="block text-small text-cielo">{who}</span>
                  </p>
                )}
              </div>
            </details>
          ))}
          <div class="flex items-center gap-lc-4 py-lc-3 text-cielo">
            <span class="h-lc-2 w-lc-2 shrink-0 rounded-full border border-cielo" aria-hidden="true"></span>
            <span class="w-20 shrink-0 font-mono text-label uppercase">2026-…</span>
            <span class="flex-1 text-body">your school's tool</span>
            <a href="/work-with-me" class="text-small text-arena underline decoration-barro-claro decoration-2 underline-offset-4 hover:text-cielo">get in touch →</a>
          </div>
        </div>

        <p class="max-w-body text-small text-cielo">
          Every entry above was requested by a colleague and adopted by name. When a number is on this
          site, there is an email behind it. And the list is an undercount: the record keeps surfacing more.
        </p>
      </Container>
    </section>

    <!-- CAREER HIGHLIGHTS -->
    <section class="py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="Experience" title="A Career Built on Every Angle">
          Having held almost every role in a school, I see education as a complete system, and build solutions that work for everyone.
        </SectionHeader>
        <Timeline class="max-w-3xl">
          {[
            {
              years: `${facts.current.startYear} – Present`,
              role: facts.current.title,
              org: `${facts.current.school} (${facts.current.schoolShort} ${facts.current.campus}), China`,
              badge: 'Current',
              notes: `Started ${facts.current.startMonth} ${facts.current.startYear}, ${facts.current.division} campus`,
            },
            {
              years: range(facts.aisc),
              role: `${facts.aisc.title} · ${facts.aisc.secondTitle}`,
              org: `${facts.aisc.school} (${facts.aisc.schoolShort}), India`,
              badge: null,
              notes: `Co-led Apple Distinguished School certification · Co-created HUMAN Framework · Built LEA · Coached ${facts.scale.facultyCoached} faculty`,
            },
            {
              years: range(facts.goa),
              role: facts.goa.title,
              org: `${facts.goa.org} (${facts.goa.orgShort}), Global`,
              badge: 'Current',
              notes: 'Teaching Geometry and Game Theory online to students worldwide',
            },
            {
              years: range(facts.vis),
              role: `${facts.vis.title} · DEIJ Taskforce`,
              org: `${facts.vis.org}, Laos`,
              badge: null,
              notes: 'Presented at AIELOC Hanoi 2024 · Contributed to DEIJ culture initiatives',
            },
            {
              years: range(facts.isp),
              role: facts.isp.roleChain,
              org: facts.isp.org,
              badge: null,
              notes: `${facts.isp.roleCount} roles across five years, building the full picture of how schools work`,
            },
            {
              years: range(facts.rabin),
              role: facts.rabin.title,
              org: `${facts.rabin.org}, ${facts.rabin.location}`,
              badge: null,
              notes: 'Founded robotics program and led IT infrastructure',
            },
          ].map(({ years, role, org, badge, notes }) => (
            <TimelineItem>
              <div class="flex flex-wrap items-center gap-lc-3">
                <Label as="span" tone="suave">{years}</Label>
                {badge && <Tag variant="status">{badge}</Tag>}
              </div>
              <h3 class="font-display text-body font-bold text-tierra">{role}</h3>
              <p class="text-small font-semibold text-selva">{org}</p>
              <p class="max-w-body text-small text-tierra-suave">{notes}</p>
            </TimelineItem>
          ))}
        </Timeline>
        <div>
          <Button href="/experience" variant="secondary">Full Journey →</Button>
        </div>
      </Container>
    </section>

    <!-- TESTIMONIALS -->
    <section class="border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="Testimonials" title="What People Say">
          {facts.survey.rating} across {facts.survey.responses} teacher responses · {facts.survey.wouldEngageAgain} would work with me again. Here's what a few of them said.
        </SectionHeader>
        <div class="grid gap-lc-5 md:grid-cols-2">
          {[
            {
              quote: 'Luis Carlos has consistently been patient, responsive, and incredibly helpful, often taking the time to troubleshoot problems thoroughly and ensure that things were fully resolved. His support has significantly reduced stress for many of us and has made a complicated process much smoother.',
              name: facts.people.keogh.name,
              role: `${facts.people.keogh.title} · unsolicited commendation to the Head of School`,
              org: facts.aisc.schoolShort,
            },
            {
              quote: 'Over the past year, we have been working to move all of our curriculum documentation into a shared Google Drive structure to create greater consistency, accessibility, and alignment across the school.',
              name: facts.people.bevans.name,
              role: facts.people.bevans.title,
              org: `${facts.aisc.schoolShort}, sent while introducing my system to ${facts.scale.incomingTeachers} incoming teachers as their first onboarding resource`,
            },
            {
              quote: 'Many students shared afterward how motivated they felt by your feedback. We are deeply grateful for your time and support of our Grade 8 learners.',
              name: facts.people.wood.name,
              role: facts.people.wood.title,
              org: `${facts.aisc.schoolShort}, on the Grade 8 Tech Investor Summit`,
            },
            {
              quote: 'Thank you so much for your help on this. It has made a massive difference in our department.',
              name: facts.people.hart.name,
              role: facts.people.hart.title,
              org: `${facts.aisc.schoolShort}, on the consent-tracking system I built for his department`,
            },
            {
              quote: 'This spreadsheet is incredible, and the video is so concise and clear.',
              name: facts.people.bull.name,
              role: facts.people.bull.title,
              org: `${facts.aisc.schoolShort}, on the Science report-comment generator`,
            },
            {
              quote: 'This is phenomenal work throughout this year that has provided extensive insight into our program.',
              name: facts.people.galaty.name,
              role: facts.people.galaty.title,
              org: facts.aisc.schoolShort,
            },
          ].map(({ quote, name, role, org }) => (
            <figure class="flex flex-col gap-lc-4 rounded-medium border border-tierra/15 bg-blanco p-lc-5 md:p-lc-6">
              <span class="h-lc-3 w-lc-3 rounded-full bg-barro" aria-hidden="true"></span>
              <blockquote class="flex-1 text-body text-tierra">"{quote}"</blockquote>
              <figcaption class="flex flex-col gap-lc-1 border-t border-tierra/15 pt-lc-3">
                <span class="text-small font-semibold text-tierra">{name}</span>
                <span class="text-small text-tierra-suave">{role} · {org}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </Container>
    </section>

    <!-- CTA -->
    <CtaPanel label="Let's Connect" title="Ready to bring AI integration, instructional coaching, or systems thinking to your school or team?">
      Whether you're a school leader exploring AI integration, an educator looking for coaching support,
      or a professional wanting to work smarter, let's start a conversation.
      <Fragment slot="actions">
        <Button href="/work-with-me">Work With Me</Button>
        <Button href={`mailto:${facts.person.email}`} variant="secondary" tone="dark">
          Send an Email
        </Button>
      </Fragment>
    </CtaPanel>

  </main>
  <Footer />
</Layout>
