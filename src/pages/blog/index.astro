---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/lc/Nav.astro';
import Footer from '../../components/lc/Footer.astro';
import Container from '../../components/lc/Container.astro';
import PageHero from '../../components/lc/PageHero.astro';
import SectionHeader from '../../components/lc/SectionHeader.astro';
import Label from '../../components/lc/Label.astro';
import Button from '../../components/lc/Button.astro';
import { facts } from '../../data/facts';
import { allPosts, excerpt, longDate } from '../../data/blog';

const posts = await allPosts();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))];
---

<Layout
  title="Blog"
  description="Insights on AI integration in education, human-centered technology, and systems thinking from Luis Carlos Moreno."
  brand
>
  <Nav />
  <main>
    <PageHero label="Blog & Insights" title="Ideas Worth Sharing">
      Reflections on AI in education, human-centered technology, systems thinking, and what it means to lead with purpose.
      <Fragment slot="actions">
        <Button href={`https://www.${facts.person.linkedin}/`} target="_blank" rel="noopener">Follow on LinkedIn</Button>
        <Button href="/work-with-me#contact" variant="secondary">Get in Touch</Button>
      </Fragment>
    </PageHero>

    <section class="py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="From the archive" title="My COETAIL Journey, 2020 to 2021">
          I wrote these posts for COETAIL, a course in educational technology and information
          literacy, while I was coaching at the {facts.isp.org}. They first lived on
          my COETAIL blog, which is now offline.
        </SectionHeader>

        {years.map((year) => (
          <div class="grid gap-lc-4 md:grid-cols-[8rem_minmax(0,1fr)]">
            <h2 class="font-display text-title text-tierra md:pt-lc-3">{year}</h2>
            <ol class="flex flex-col">
              {posts.filter((p) => p.data.date.getUTCFullYear() === year).map((post) => (
                <li class="border-t border-tierra/15 first:border-t-0 md:first:border-t">
                  <a href={`/blog/${post.slug}`} class="group flex flex-col gap-lc-2 py-lc-4">
                    <Label as="span" tone="suave">{longDate(post.data.date)}</Label>
                    <span class="font-display text-heading text-tierra group-hover:text-barro">{post.data.title}</span>
                    <span class="max-w-body text-small text-tierra-suave">{excerpt(post.body)}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </Container>
    </section>
  </main>
  <Footer />
</Layout>
