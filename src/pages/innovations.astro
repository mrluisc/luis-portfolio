---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/lc/Nav.astro';
import Footer from '../components/lc/Footer.astro';
import Container from '../components/lc/Container.astro';
import PageHero from '../components/lc/PageHero.astro';
import SectionHeader from '../components/lc/SectionHeader.astro';
import Stats from '../components/lc/Stats.astro';
import Label from '../components/lc/Label.astro';
import Tag from '../components/lc/Tag.astro';
import Button from '../components/lc/Button.astro';
import CtaPanel from '../components/lc/CtaPanel.astro';
import { facts } from '../data/facts';

// Every number, title, name and date on this page comes from src/data/facts.ts.
// Do not retype one here - npm run check:facts will fail the build.
---

<Layout
  title="Signature Innovations"
  description={`The HUMAN Framework for ethical AI integration, the Learning Experience Analyzer (LEA), and ${facts.scale.tools} custom automation tools built to transform how schools approach technology.`}
>
  <Nav />
  <main>

    <!-- HERO -->
    <PageHero label="Signature Innovations" title="Tools & Frameworks That Transform How Schools Approach AI">
      Built from real classroom needs, tested across three international school divisions,
      and designed to benefit students, teachers, and leadership simultaneously.
    </PageHero>

    <!-- HUMAN FRAMEWORK -->
    <section id="human-framework" class="scroll-mt-lc-9 py-lc-9">
      <Container class="grid items-start gap-lc-8 md:grid-cols-2">
        <div class="flex flex-col gap-lc-5">
          <SectionHeader label="Framework" title="The HUMAN Framework" />
          <p class="text-small text-tierra-suave">Co-created with <strong class="font-semibold text-tierra">{facts.people.perezTalavera.name}</strong></p>
          <p class="max-w-body text-body text-tierra">
            A practical guide for the human-centered use and selective integration of AI in education.
            Rather than prescribing when to use AI, the framework gives teachers and students a shared
            vocabulary and clear map for making intentional, ethical choices.
          </p>
          <div class="flex flex-col gap-lc-3">
            <Label as="h3">Two Core Principles</Label>
            <div class="grid grid-cols-2 gap-lc-3">
              <div class="rounded-medium border border-tierra/15 bg-blanco p-lc-4 text-small font-semibold text-tierra">Preserving Learning</div>
              <div class="rounded-medium border border-tierra/15 bg-blanco p-lc-4 text-small font-semibold text-tierra">Maintaining Integrity</div>
            </div>
          </div>
          <div class="flex flex-wrap gap-lc-2">
            {['Presented at AIFE Jakarta', 'Data in Schools KL', 'School-wide Guidelines', 'Ethical AI'].map(t => (
              <Tag>{t}</Tag>
            ))}
          </div>
          <div class="pt-lc-2">
            <Button href={`mailto:${facts.person.email}?subject=HUMAN Framework Inquiry`}>
              Ask About Implementation
            </Button>
          </div>
        </div>

        <div class="flex flex-col gap-lc-4">
          <img src="/images/human-framework.png" alt="HUMAN Framework poster" class="w-full rounded-medium border border-tierra/15" />
          <h3 class="pt-lc-4 font-display text-heading text-tierra">The Five Levels</h3>
          <ol class="flex flex-col gap-lc-3">
            {[
              { letter: 'H', label: 'Human Thinking & Discovery', desc: 'Students engage in a learning task alone, without AI support. This preserves the foundational cognitive work that builds understanding and skill.' },
              { letter: 'U', label: 'Utilizing AI for Planning & Research', desc: 'Students chart their own ideas, with AI supporting through the planning, outlining, and research process. The ideas remain theirs.' },
              { letter: 'M', label: 'Maximizing Ideas with AI', desc: 'Students use AI as a thought partner to generate ideas they will fully develop on their own. AI sparks possibilities; students do the work.' },
              { letter: 'A', label: 'AI Feedforward', desc: 'Students use AI to get feedforward, suggestions and possibilities for enhancing their work before final submission.' },
              { letter: 'N', label: 'New AI-Created Elements', desc: 'Students use AI to create new elements that expand their learning, focusing on work outside their main learning goals.' },
            ].map(({ letter, label, desc }) => (
              <li class="flex gap-lc-4 border-t border-tierra/15 pt-lc-3">
                <span class="flex h-lc-7 w-lc-7 shrink-0 items-center justify-center rounded-small bg-selva font-display text-heading text-arena" aria-hidden="true">{letter}</span>
                <div class="flex flex-col gap-lc-1">
                  <span class="text-small font-semibold text-tierra">{label}</span>
                  <span class="text-small text-tierra-suave">{desc}</span>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </Container>
    </section>

    <!-- LEA -->
    <section id="lea" class="scroll-mt-lc-9 border-t border-tierra/10 py-lc-9">
      <Container class="grid items-start gap-lc-8 md:grid-cols-2">
        <div class="order-2 flex flex-col gap-lc-5 md:order-1">
          <img src="/images/lea-human-framework.jpeg" alt="LEA with HUMAN Framework" class="w-full rounded-medium border border-tierra/15" />
          <img src="/images/lea-web.jpeg" alt="LEA web interface" class="w-full rounded-medium border border-tierra/15" />
        </div>
        <div class="order-1 flex flex-col gap-lc-5 md:order-2">
          <SectionHeader label="AI-Powered Tool" title="Learning Experience Analyzer (LEA)" />
          <p class="max-w-body text-body text-tierra">
            What began as a practical tool for teachers evolved into a school-wide data system.
            Paste any learning activity and LEA analyzes it in real time against multiple frameworks
            simultaneously, generating specific, time-bounded improvement recommendations.
          </p>

          <div class="flex flex-col gap-lc-3">
            <h3 class="text-small font-semibold text-tierra">Frameworks analyzed:</h3>
            <div class="flex flex-wrap gap-lc-2">
              {['HUMAN Framework', 'UbD (Understanding by Design)', 'UDL', "Bloom's Taxonomy", 'School Mission & Values', 'Social-Emotional Learning'].map(f => (
                <Tag>{f}</Tag>
              ))}
            </div>
          </div>

          <dl class="grid grid-cols-3 gap-lc-3">
            {[
              { tier: 'Students', impact: 'Better-designed learning experiences' },
              { tier: 'Teachers', impact: 'Streamlined planning without cognitive overload' },
              { tier: 'Leadership', impact: 'Data for hiring, PD & strategic decisions' },
            ].map(({ tier, impact }) => (
              <div class="flex flex-col gap-lc-1 border-t border-tierra/15 pt-lc-2">
                <dt class="text-small font-semibold text-tierra">{tier}</dt>
                <dd class="text-small text-tierra-suave">{impact}</dd>
              </div>
            ))}
          </dl>

          <blockquote class="border-l-2 border-barro pl-lc-5 text-lead text-tierra">
            "The unexpected discovery: in a framework designed for AI integration, 'not using AI'
            became the most popular and pedagogically valuable choice, revealing insights that
            transformed our entire approach to educational technology."
          </blockquote>

          <div class="pt-lc-2">
            <Button href={`mailto:${facts.person.email}?subject=LEA Tool - Try It`}>
              Request Access to LEA
            </Button>
          </div>
        </div>
      </Container>
    </section>

    <!-- CUSTOM TOOLS -->
    <section id="tools" class="scroll-mt-lc-9 border-t border-tierra/10 py-lc-9">
      <Container class="flex flex-col gap-lc-7">
        <SectionHeader label="Custom Tools" title={`${facts.scale.tools} Custom Automation Tools`}>
          Built to solve real problems, saving teachers hours every week, systematizing workflows, and bringing data to decisions.
        </SectionHeader>
        <div class="grid gap-lc-5 sm:grid-cols-2 lg:grid-cols-3">
          {[
            { name: 'Report Card Comment Generator', desc: 'AI-powered personalized student comments for Middle and High School. Reduced report writing time by hours per teacher per cycle.', tag: 'Most Used' },
            { name: 'Learning Experience Analyzer (LEA)', desc: 'Multi-framework lesson analysis tool with real-time recommendations. Three-tier impact: students, teachers, and leadership.', tag: 'Flagship' },
            { name: 'Classroom Observation Tool', desc: 'Structured coaching observation and feedback system for MS and HS administrators and instructional coaches.', tag: 'Coaching' },
            { name: 'STEAM Week Organizer', desc: 'End-to-end event planning and coordination system for school-wide STEAM festivals with 200+ participants.', tag: 'Events' },
            { name: 'Digital Citizenship Tracker', desc: `Student self-reflection and media tracking tool used with ${facts.scale.digitalCitizenshipStudents} students annually across all three divisions.`, tag: 'Students' },
            { name: 'Professional Learning Dashboard', desc: 'Faculty PD tracking, survey aggregation, and coaching cycle management across three school divisions.', tag: 'Faculty' },
          ].map(({ name, desc, tag }) => (
            <div class="flex flex-col gap-lc-3 rounded-medium border border-tierra/15 bg-blanco p-lc-5">
              <Tag class="w-fit">{tag}</Tag>
              <h3 class="font-display text-body font-bold text-tierra">{name}</h3>
              <p class="text-small text-tierra-suave">{desc}</p>
            </div>
          ))}
        </div>
        <div class="flex flex-col gap-lc-2 rounded-medium bg-selva p-lc-6 md:p-lc-7">
          <p class="font-display text-title text-barro-claro">{facts.sevai.hoursSaved} hours</p>
          <p class="text-body text-arena">of manual placement work eliminated by the SEVAI engine alone</p>
        </div>
      </Container>
    </section>

    <!-- PHILOSOPHY -->
    <section class="bg-selva py-lc-9 text-arena">
      <Container class="grid items-center gap-lc-8 md:grid-cols-2">
        <div class="flex flex-col gap-lc-5">
          <SectionHeader tone="dark" label="My AI Philosophy" title="Human-Centered Technology" />
          <p class="max-w-body text-body">
            I believe AI should empower teachers, not replace them or overwhelm them with guilt.
            My goal is for every teacher to be able to say <strong class="font-semibold">"I want to use AI"</strong> or
            <strong class="font-semibold">"I don't want to use AI"</strong>, and have a clear, confident reason for either choice.
          </p>
          <p class="max-w-body text-body">
            The surprising discovery from {facts.scale.leaMonths} months of LEA implementation: "not using AI" was the
            most popular and pedagogically valuable choice. That insight reshaped everything.
          </p>
        </div>
        <img src="/images/headshot-3.jpeg" alt="Luis Carlos Moreno" class="max-h-[400px] w-full rounded-medium object-cover" />
      </Container>
    </section>

    <!-- STATS + CTA -->
    <Container class="pt-lc-8">
      <Stats
        items={[
            { value: facts.scale.tools, label: 'Custom Tools Built', note: 'deployed across 3 school divisions' },
            { value: facts.conferences.career, label: 'International Conferences', note: facts.conferences.careerList },
            { value: facts.scale.leaMonths, label: 'Months of LEA Data', note: 'informing school-wide strategy' },
        ]}
      />
    </Container>
    <CtaPanel title="Ready to Transform Your School's Approach to AI?">
      Whether you want to implement the HUMAN Framework, pilot LEA, or explore what a custom tool could look like for your school, let's talk.
      <Fragment slot="actions">
        <Button href="/work-with-me">Work With Me</Button>
      </Fragment>
    </CtaPanel>

  </main>
  <Footer />
</Layout>
