---
/** A row of key numbers: the number in the headline face, a small label under it, a hairline above. */
interface Props {
  items: { value: string | number; label: string }[];
}
const { items } = Astro.props;
---

<dl class="grid grid-cols-2 gap-x-lc-5 gap-y-lc-6 md:grid-cols-4">
  {items.map(({ value, label }) => (
    <div class="flex flex-col-reverse gap-lc-2 border-t-2 border-tierra pt-lc-3">
      <dt class="font-mono text-label uppercase text-tierra-suave">{label}</dt>
      <dd class="font-display text-title text-tierra [font-variant-numeric:tabular-nums]">{value}</dd>
    </div>
  ))}
</dl>
