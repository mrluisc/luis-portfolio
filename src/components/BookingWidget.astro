---
/**
 * BookingWidget.astro — inline Cal.com booking calendar.
 *
 * Renders nothing unless config.calLink is set, so the section cannot ship
 * broken. Set the link in src/data/config.ts and it appears on next build.
 */
import { config, hasCal } from '../data/config';
import tokens from '../brand/tokens.json';
import Container from './lc/Container.astro';
import SectionHeader from './lc/SectionHeader.astro';

const calLink = config.calLink;
// "mrluisc/30min" → namespace "30min", used to scope the Cal embed API.
const namespace = calLink.split('/').pop() ?? 'booking';
// Cal.com's accent colour, from the brand tokens.
const calBrand = tokens.color.barro.$value;
---

{hasCal && (
  <section id="book" class="scroll-mt-lc-9 border-t border-tierra/10 py-lc-9">
    <Container class="flex flex-col gap-lc-7">
      <SectionHeader label="Book a Call" title="Pick a Time That Works">
        The first conversation is always free. Grab a slot directly, no back-and-forth email needed.
      </SectionHeader>
      <div
        id="cal-inline"
        data-cal-link={calLink}
        data-cal-namespace={namespace}
        data-cal-brand={calBrand}
        class="min-h-[600px] w-full overflow-hidden rounded-medium border border-tierra/15 bg-blanco"
      >
        <noscript>
          <p class="p-lc-6 text-small text-tierra-suave">
            Booking needs JavaScript. Email me instead and we'll find a time.
          </p>
        </noscript>
      </div>
    </Container>

    <script>
      // Cal.com's official inline-embed loader, scoped to the element above.
      const el = document.getElementById('cal-inline');
      if (el) {
        const link = el.dataset.calLink;
        const ns = el.dataset.calNamespace;
        const brand = el.dataset.calBrand;
        (function (C, A, L) {
          let p = function (a, ar) { a.q.push(ar); };
          let d = C.document;
          C.Cal = C.Cal || function () {
            let cal = C.Cal; let ar = arguments;
            if (!cal.loaded) {
              cal.ns = {}; cal.q = cal.q || [];
              d.head.appendChild(d.createElement('script')).src = A;
              cal.loaded = true;
            }
            if (ar[0] === L) {
              const api = function () { p(api, arguments); };
              const namespace = ar[1];
              api.q = api.q || [];
              if (typeof namespace === 'string') {
                cal.ns[namespace] = cal.ns[namespace] || api;
                p(cal.ns[namespace], ar);
                p(cal, ['initNamespace', namespace]);
              } else { p(cal, ar); }
              return;
            }
            p(cal, ar);
          };
        })(window, 'https://app.cal.com/embed/embed.js', 'init');

        Cal('init', ns, { origin: 'https://cal.com' });
        Cal.ns[ns]('inline', {
          elementOrSelector: '#cal-inline',
          config: { layout: 'month_view' },
          calLink: link,
        });
        Cal.ns[ns]('ui', {
          hideEventTypeDetails: false,
          layout: 'month_view',
          cssVarsPerTheme: { light: { 'cal-brand': brand } },
        });
      }
    </script>
  </section>
)}
