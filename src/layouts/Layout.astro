---
import '../brand/tokens.css';
import { fontsHref } from '../brand/theme.mjs';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Use the LC brand look. Becomes the default when the pages are restyled (step 4). */
  brand?: boolean;
  /** Keep the page out of search results. */
  noindex?: boolean;
}

const {
  title,
  description = 'Learning Innovation & Technology Coach | AI Integration Specialist | Co-creator of the HUMAN Framework. Engineering solutions, empowering educators.',
  image = '/images/headshot.jpg',
  brand = false,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Primary Meta -->
    <title>{title} | Luis Carlos Moreno</title>
    <meta name="description" content={description} />
    <meta name="author" content="Luis Carlos Moreno" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Luis Carlos Moreno`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Luis Carlos Moreno`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />

    <!-- LC brand fonts, from the tokens -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <slot name="head" />
  </head>
  <body class={brand ? 'bg-arena font-text text-body text-tierra antialiased' : 'bg-white'}>
    <slot />
  </body>
</html>
